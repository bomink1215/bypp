# 카카오 developers(https://developers.kakao.com) 앱 등록 후 발급
# REST API 키 — 서버 라우트에서만 사용. 절대 NEXT_PUBLIC_ 붙이지 말 것.
KAKAO_REST_API_KEY=
# 카카오 로그인 토큰 교환용 클라이언트 시크릿(앱 → 플랫폼 키 → REST API 키). 서버 전용.
KAKAO_CLIENT_SECRET=
# JavaScript 키 — 지도 SDK용. 브라우저에 노출되므로 플랫폼 도메인 등록 필수.
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase(https://supabase.com) 프로젝트의 Settings → API Keys
SUPABASE_URL=
# secret 키(sb_secret_… 또는 레거시 service_role). RLS를 우회하므로 절대 NEXT_PUBLIC_ 금지.
SUPABASE_SECRET_KEY=
# 브라우저 로그인용. 둘 다 노출돼도 되는 값이다(publishable 키는 RLS의 제약을 받는다).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
